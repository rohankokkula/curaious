# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; this file is committed and must never hold secrets.

# ── Application form → Google Sheets (existing, unrelated to season 1) ──
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# ── Supabase (season 1 auth, dashboard, admin) ──
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API → service_role. SERVER-ONLY: bypasses row level
# security. Never prefix it with NEXT_PUBLIC_ and never use it in a Client
# Component.
SUPABASE_SERVICE_ROLE_KEY=

# Where magic links come back to. Must match Auth → URL Configuration in
# Supabase, which also needs {NEXT_PUBLIC_SITE_URL}/auth/callback listed as a
# redirect URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Private Storage bucket that holds presentation decks.
SUPABASE_STORAGE_DECKS_BUCKET=decks
